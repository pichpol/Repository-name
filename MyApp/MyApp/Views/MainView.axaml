<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="using:MyApp.ViewModels"
             xmlns:data="using:MyApp.Data"
             mc:Ignorable="d" d:DesignWidth="360" d:DesignHeight="640"
             x:Class="MyApp.Views.MainView"
             x:DataType="vm:MainViewModel">
    <Design.DataContext>
        <vm:MainViewModel />
    </Design.DataContext>

    <TabControl Margin="4">

        <!--Аренды-->
        <TabItem Header="Аренды">
            <ScrollViewer>
                <StackPanel Spacing="8" Margin="8">

                    <TextBlock Text="Аренды" FontSize="20" FontWeight="SemiBold" />

                    <StackPanel Spacing="4">
                        <TextBlock Text="Клиент" />
                        <ComboBox x:Name="ClientCombo" MinHeight="40"
                                  HorizontalAlignment="Stretch"
                                  PlaceholderText="Выберите клиента">
                            <ComboBox.ItemTemplate>
                                <DataTemplate x:DataType="data:Client">
                                    <TextBlock Text="{Binding FullName}" />
                                </DataTemplate>
                            </ComboBox.ItemTemplate>
                        </ComboBox>
                    </StackPanel>

                    <StackPanel Spacing="4">
                        <TextBlock Text="Предмет" />
                        <ComboBox x:Name="ItemCombo" MinHeight="40"
                                  HorizontalAlignment="Stretch"
                                  PlaceholderText="Выберите предмет">
                            <ComboBox.ItemTemplate>
                                <DataTemplate x:DataType="data:Item">
                                    <TextBlock Text="{Binding Title}" />
                                </DataTemplate>
                            </ComboBox.ItemTemplate>
                        </ComboBox>
                    </StackPanel>

                    <StackPanel Spacing="4">
                        <TextBlock Text="Дата выдачи" />
                        <CalendarDatePicker x:Name="StartPicker" MinHeight="40"
                                            HorizontalAlignment="Stretch" />
                    </StackPanel>

                    <StackPanel Spacing="4">
                        <TextBlock Text="Дата возврата" />
                        <CalendarDatePicker x:Name="EndPicker" MinHeight="40"
                                            HorizontalAlignment="Stretch" />
                    </StackPanel>

                    <StackPanel Spacing="4">
                        <TextBlock Text="Стоимость, руб." />
                        <TextBox x:Name="CostBox" MinHeight="40"
                                 HorizontalAlignment="Stretch" />
                    </StackPanel>

                    <CheckBox x:Name="ReturnedBox" Content="Возвращено" MinHeight="40" />

                    <Button Content="Добавить" Click="AddRental_Click"
                            MinHeight="40" HorizontalAlignment="Stretch" />
                    <Button Content="Удалить" Click="DeleteRental_Click"
                            MinHeight="40" HorizontalAlignment="Stretch" />

                    <TextBlock x:Name="RentalsMessage" Foreground="DarkRed" TextWrapping="Wrap" />

                    <ListBox x:Name="RentalsList" MaxHeight="250">
                        <ListBox.ItemTemplate>
                            <DataTemplate x:DataType="data:Rental">
                                <StackPanel Spacing="2" Margin="0,4">
                                    <TextBlock Text="{Binding Client.FullName}" FontWeight="SemiBold" TextWrapping="Wrap" />
                                    <TextBlock Text="{Binding Item.Title}" TextWrapping="Wrap" />
                                    <TextBlock Text="{Binding StartDate, StringFormat='Выдано: {0:dd.MM.yyyy}'}" />
                                    <TextBlock Text="{Binding EndDate, StringFormat='Вернуть: {0:dd.MM.yyyy}'}" />
                                    <TextBlock Text="{Binding TotalCost, StringFormat='Стоимость: {0} руб.'}" />
                                    <TextBlock Text="Возвращено" Foreground="Green"
                                               IsVisible="{Binding IsReturned}" />
                                    <TextBlock Text="На руках" Foreground="OrangeRed"
                                               IsVisible="{Binding !IsReturned}" />
                                </StackPanel>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </StackPanel>
            </ScrollViewer>
        </TabItem>

        <!--Клиенты-->
        <TabItem Header="Клиенты">
            <ScrollViewer>
                <StackPanel Spacing="8" Margin="8">

                    <TextBlock Text="Клиенты" FontSize="20" FontWeight="SemiBold" />

                    <StackPanel Spacing="4">
                        <TextBlock Text="ФИО" />
                        <TextBox x:Name="FullNameBox" MinHeight="40"
                                 HorizontalAlignment="Stretch" />
                    </StackPanel>

                    <StackPanel Spacing="4">
                        <TextBlock Text="Телефон" />
                        <TextBox x:Name="PhoneBox" MinHeight="40"
                                 HorizontalAlignment="Stretch" />
                    </StackPanel>

                    <StackPanel Spacing="4">
                        <TextBlock Text="Бонусные баллы" />
                        <TextBox x:Name="PointsBox" MinHeight="40"
                                 HorizontalAlignment="Stretch" />
                    </StackPanel>

                    <Button Content="Добавить" Click="AddClient_Click"
                            MinHeight="40" HorizontalAlignment="Stretch" />
                    <Button Content="Сохранить" Click="SaveClient_Click"
                            MinHeight="40" HorizontalAlignment="Stretch" />
                    <Button Content="Удалить" Click="DeleteClient_Click"
                            MinHeight="40" HorizontalAlignment="Stretch" />

                    <TextBlock x:Name="ClientsMessage" Foreground="DarkRed" TextWrapping="Wrap" />

                    <ListBox x:Name="ClientsList" MaxHeight="250"
                             SelectionChanged="ClientsList_SelectionChanged">
                        <ListBox.ItemTemplate>
                            <DataTemplate x:DataType="data:Client">
                                <StackPanel Spacing="2" Margin="0,4">
                                    <TextBlock Text="{Binding FullName}" FontWeight="SemiBold" TextWrapping="Wrap" />
                                    <TextBlock Text="{Binding PhoneNumber}" />
                                    <TextBlock Text="{Binding LoyaltyPoints, StringFormat='Бонусные баллы: {0}'}" />
                                </StackPanel>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </StackPanel>
            </ScrollViewer>
        </TabItem>

        <!--Прокат-->
        <TabItem Header="Прокат">
            <ScrollViewer>
                <StackPanel Spacing="8" Margin="8">

                    <TextBlock Text="Фототехника и настольные игры"
                               FontSize="20" FontWeight="SemiBold" TextWrapping="Wrap" />

                    <StackPanel Spacing="4">
                        <TextBlock Text="Название" />
                        <TextBox x:Name="TitleBox" MinHeight="40"
                                 HorizontalAlignment="Stretch" />
                    </StackPanel>

                    <StackPanel Spacing="4">
                        <TextBlock Text="Категория" />
                        <TextBox x:Name="CategoryBox" MinHeight="40"
                                 HorizontalAlignment="Stretch" />
                    </StackPanel>

                    <StackPanel Spacing="4">
                        <TextBlock Text="Цена за сутки, руб." />
                        <TextBox x:Name="PriceBox" MinHeight="40"
                                 HorizontalAlignment="Stretch" />
                    </StackPanel>

                    <Button Content="Добавить" Click="AddItem_Click"
                            MinHeight="40" HorizontalAlignment="Stretch" />
                    <Button Content="Удалить" Click="DeleteItem_Click"
                            MinHeight="40" HorizontalAlignment="Stretch" />

                    <TextBlock x:Name="ItemsMessage" Foreground="DarkRed" TextWrapping="Wrap" />

                    <ListBox x:Name="ItemsList" MaxHeight="250">
                        <ListBox.ItemTemplate>
                            <DataTemplate x:DataType="data:Item">
                                <StackPanel Spacing="2" Margin="0,4">
                                    <TextBlock Text="{Binding Title}" FontWeight="SemiBold" TextWrapping="Wrap" />
                                    <TextBlock Text="{Binding Category}" />
                                    <TextBlock Text="{Binding PricePerDay, StringFormat='{}{0} руб./сутки'}" />
                                </StackPanel>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </StackPanel>
            </ScrollViewer>
        </TabItem>

        <!--Карточки-->
        <TabItem Header="Карточки">
            <ScrollViewer>
                <StackPanel Spacing="8" Margin="8">

                    <TextBlock Text="Клиент и его аренды"
                               FontSize="20" FontWeight="SemiBold" TextWrapping="Wrap" />

                    <ListBox x:Name="ClientCardsList" MaxHeight="250">
                        <ListBox.ItemTemplate>
                            <DataTemplate x:DataType="data:Client">
                                <StackPanel Spacing="4" Margin="0,8">
                                    <TextBlock Text="{Binding FullName}" FontSize="16" FontWeight="SemiBold"
                                               TextWrapping="Wrap" />
                                    <TextBlock Text="{Binding PhoneNumber}" />
                                    <TextBlock Text="Аренды:" FontWeight="SemiBold" />
                                    <ListBox ItemsSource="{Binding Rentals}">
                                        <ListBox.ItemTemplate>
                                            <DataTemplate x:DataType="data:Rental">
                                                <StackPanel Spacing="1" Margin="0,2">
                                                    <TextBlock Text="{Binding Item.Title}" TextWrapping="Wrap" />
                                                    <TextBlock Text="{Binding StartDate, StringFormat='Выдано: {0:dd.MM.yyyy}'}" />
                                                    <TextBlock Text="{Binding EndDate, StringFormat='Вернуть: {0:dd.MM.yyyy}'}" />
                                                    <TextBlock Text="{Binding TotalCost, StringFormat='{}{0} руб.'}" />
                                                </StackPanel>
                                            </DataTemplate>
                                        </ListBox.ItemTemplate>
                                    </ListBox>
                                </StackPanel>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </StackPanel>
            </ScrollViewer>
        </TabItem>

    </TabControl>
</UserControl>